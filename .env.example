DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prototipe_pegadaian
BETTER_AUTH_SECRET=change-this-to-a-32-char-secret-minimum
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-this-cron-secret
# Optional production setting. Point this to a Dokploy persistent volume
# so uploaded item media, payment proofs, and handover proofs survive redeploys.
# Leave empty locally to use ./public/uploads.
UPLOADS_DIR=
# Set to "hours" locally when testing blacklist escalation without waiting days.
BLACKLIST_DURATION_UNIT=days
