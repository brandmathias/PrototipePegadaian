DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prototipe_pegadaian
BETTER_AUTH_SECRET=change-this-to-a-32-char-secret-minimum
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-this-cron-secret
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional production setting. Point this to a Dokploy persistent volume
# so uploaded item media, payment proofs, and handover proofs survive redeploys.
# Leave empty locally to use ./public/uploads.
UPLOADS_DIR=
# Set to "hours" locally when testing blacklist escalation without waiting days.
BLACKLIST_DURATION_UNIT=days
# Midtrans Snap. Simpan Server Key hanya pada environment server/Dokploy.
MIDTRANS_SERVER_KEY=
# Client Key bersifat public dan dipakai untuk Snap JS Embedded/Popup.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Gunakan false untuk Sandbox. Ubah menjadi true hanya setelah key dan webhook Production dikonfigurasi.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
